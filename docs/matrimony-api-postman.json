{
  "info": {
    "name": "Matrimony API (Live Routes)",
    "_postman_id": "5b7f3c74-2f6a-4a40-9ad9-4d8f1c4f9b22",
    "description": "Minimal live-route collection aligned to backend/src/routes/routes.registry.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"+919876543210\",\"type\":\"signup\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/request-otp"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"+919876543210\",\"otp\":\"123456\",\"otp_id\":\"{{otp_id}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/verify-otp"
          }
        },
        {
          "name": "Login Firebase",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"idToken\":\"{{firebase_id_token}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login-firebase"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/users/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Asha\",\"lastName\":\"Iyer\",\"gender\":\"female\",\"maritalStatus\":\"never_married\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/users/profile"
          }
        },
        {
          "name": "Save Preferences",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"min_age\":21,\"max_age\":35,\"religion\":\"Any\",\"preferred_locations\":\"Mumbai, Pune\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/users/profile/preferences"
          }
        },
        {
          "name": "Update Privacy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"showPhone\":false,\"showPhoto\":true}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/users/privacy"
          }
        },
        {
          "name": "Save Onboarding Progress",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"step\":2,\"route\":\"/step-2\",\"draft\":{}}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/users/onboarding/progress"
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "Filters",
          "request": { "method": "GET", "url": "{{base_url}}/meta/filters" }
        },
        {
          "name": "Locations",
          "request": { "method": "GET", "url": "{{base_url}}/meta/locations" }
        }
      ]
    },
    {
      "name": "Search & Matches",
      "item": [
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/search?mode=regular&limit=20"
          }
        },
        {
          "name": "Matches",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/matches?limit=20&page=1"
          }
        },
        {
          "name": "Match Feedback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"targetUserId\":\"{{user_id}}\",\"action\":\"like\",\"source\":\"matches_feed\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/matches/feedback"
          }
        }
      ]
    },
    {
      "name": "Interactions & Shortlist",
      "item": [
        {
          "name": "Interests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/interactions/interests?type=received"
          }
        },
        {
          "name": "Like",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"receiverId\":\"{{user_id}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/interactions/like"
          }
        },
        {
          "name": "Decline",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{user_id}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/interactions/decline"
          }
        },
        {
          "name": "Shortlist Add",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"shortlistedUserId\":\"{{user_id}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/shortlist/add"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Conversations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/chat/conversations"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"receiverId\":\"{{user_id}}\",\"content\":\"Hello\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/chat/send"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Plans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/payment/plans"
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"plan\":\"standard\",\"amount\":1999}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment/create-order"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{order_id}}\",\"paymentId\":\"{{payment_id}}\",\"signature\":\"{{signature}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/payment/verify"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/admin/dashboard"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000/api" },
    { "key": "access_token", "value": "YOUR_ACCESS_TOKEN" },
    { "key": "otp_id", "value": "" },
    { "key": "firebase_id_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "order_id", "value": "" },
    { "key": "payment_id", "value": "" },
    { "key": "signature", "value": "" }
  ]
}
