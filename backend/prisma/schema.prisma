generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone               String?     @unique
  email               String?     @unique
  passwordHash        String?
  isVerified          Boolean     @default(false)
  verificationCode    String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lastLogin           DateTime?
  lastActiveAt        DateTime?
  statusReconfirmedAt DateTime?
  searchStatus        String      @default("active") // active | low_activity | paused | found_match | married | closed
  profileVersion      Int         @default(1)
  deletedAt           DateTime?
  isActive            Boolean     @default(true)
  isBanned            Boolean     @default(false)
  banReason           String?
  banExpiresAt        DateTime?
  role                String      @default("user") // user | admin

  // Identity Verification
  identityStatus    String      @default("unverified") // unverified | pending | verified | rejected
  identityDocUrl    String?

  // Social Login
  socialProvider    String?
  socialId          String?

  // Relations
  profile                 Profile?
  partnerPreference       PartnerPreference?
  photos                  Photo[]
  verifications           Verification[]
  subscriptions           Subscription[]
  payments                Payment[]
  likesSent               Like[]              @relation("sender")
  likesReceived           Like[]              @relation("receiver")
  matches                 Match[]             @relation("userA")
  matchesAsUserB          Match[]             @relation("userB")
  messages                Message[]
  reports                 Report[]            @relation("reporter")
  reportsReceived         Report[]            @relation("reported")
  shortlists              Shortlist[]         @relation("shortlister")
  shortlistedBy           Shortlist[]         @relation("shortlisted")
  savedSearches           SavedSearch[]
  reviewsWritten          Review[]            @relation("reviewer")
  reviewsReceived         Review[]            @relation("reviewedUser")
  adminUser               AdminUser?
  auditLogs               AuditLog[]
  blocksInitiated         UserBlock[]         @relation("blocker")
  blocksReceived          UserBlock[]         @relation("blocked")
  exposuresGiven          ProfileExposure[]   @relation("exposureViewer")
  exposuresReceived       ProfileExposure[]   @relation("exposureCandidate")
  contactRequestsSent     ContactRequest[]    @relation("contactRequester")
  contactRequestsReceived ContactRequest[]    @relation("contactTarget")
  photoAccessSent         PhotoAccessRequest[] @relation("photoAccessRequester")
  photoAccessReceived     PhotoAccessRequest[] @relation("photoAccessTarget")
  supportTickets          SupportTicket[]
  riskSignals             RiskSignal[]

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([isActive])
  @@index([isBanned])
  @@index([socialId])
  @@index([searchStatus])
  @@index([lastActiveAt])
}

model Shortlist {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @db.Uuid
  shortlistedUserId String   @db.Uuid
  createdAt         DateTime @default(now())

  user              User     @relation("shortlister", fields: [userId], references: [id], onDelete: Cascade)
  shortlistedUser   User     @relation("shortlisted", fields: [shortlistedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, shortlistedUserId])
  @@index([userId])
}

model Profile {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String      @unique @db.Uuid
  firstName             String
  lastName              String?
  dateOfBirth           DateTime    @db.Date
  gender                String
  heightCm              Int?
  maritalStatus         String
  bio                   String?     @db.Text
  religion              String?
  caste                 String?
  subCaste              String?
  motherTongue          String?
  country               String      @default("India")
  state                 String?
  city                  String?
  educationLevel        String?
  educationField        String?
  profession            String?
  company               String?
  incomeBand            String?
  foodHabit             String?
  drinks                String?
  smokes                String?
  hobbies               String[]    @default([])
  religiousness         String?
  completionPercentage  Int         @default(0)
  role                  String      @default("self") // self | parent | sibling | guardian | relative
  managerRelationship   String?
  intent                String      @default("flexible")

  videoUrl              String?
  videoThumbnail        String?

  birthTime             String?
  birthPlace            String?
  gothra                String?
  zodiacSign            String?
  nakshatra             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([religion, caste])
  @@index([dateOfBirth])
  @@index([city])
  @@index([state])
  @@index([createdAt])
}

model PartnerPreference {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String      @unique @db.Uuid
  minAge                Int         @default(18)
  maxAge                Int         @default(60)
  preferredLocations    String[]    @default([])
  religionOpen          Boolean     @default(true)
  preferredReligions    String[]    @default([])
  casteOpen             Boolean     @default(true)
  preferredCastes       String[]    @default([])
  minEducation          String?
  minIncomeBand         String?
  foodHabitPreferences  String[]    @default([])
  hardFields            String[]    @default([]) // fields the user marked "must match"
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Photo {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @db.Uuid
  photoUrl           String
  thumbnailUrl       String?
  isPrimary          Boolean     @default(false)
  uploadedAt         DateTime    @default(now())
  width              Int?
  height             Int?
  fileSizeKb         Int?
  verificationStatus String      @default("not_started") // not_started | pending | verified | rejected
  moderationStatus   String      @default("approved") // processing | approved | review_required | rejected | failed
  rejectionReason    String?
  verifiedAt         DateTime?

  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isPrimary])
  @@index([verificationStatus])
  @@index([moderationStatus])
}

model Verification {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @db.Uuid
  type            String      // phone | email | photo | selfie | id | employment | education
  status          String      @default("not_started")
  documentUrl     String?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
  @@index([type])
}

model Like {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId    String      @db.Uuid
  receiverId  String      @db.Uuid
  status      String      @default("sent") // sent | accepted | rejected | withdrawn | expired | blocked
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sender      User        @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Match {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId         String      @db.Uuid
  userBId         String      @db.Uuid
  createdAt       DateTime    @default(now())
  lastMessageAt   DateTime?
  isActive        Boolean     @default(true)

  userA           User        @relation("userA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User        @relation("userB", fields: [userBId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([isActive])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId         String      @db.Uuid
  senderId        String      @db.Uuid
  content         String      @db.Text
  clientMessageId String?     @unique
  status          String      @default("sent") // queued | sent | delivered | read | failed
  isRead          Boolean     @default(false)
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender          User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([isRead])
  @@index([status])
}

model Subscription {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @db.Uuid
  plan          String
  planVersion   Int         @default(1)
  status        String      @default("active") // pending | active | grace | expired | cancelled | refunded
  startedAt     DateTime    @default(now())
  expiresAt     DateTime?
  autoRenew     Boolean     @default(false)
  renewalStatus String      @default("none") // none | enabled | cancelled | pending
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([plan])
}

model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @db.Uuid
  subscriptionId      String?       @db.Uuid
  amountInr           Decimal       @db.Decimal(10, 2)
  plan                String
  status              String        @default("pending") // pending | completed | failed | refunded | partially_refunded
  gateway             String        @default("razorpay")
  idempotencyKey      String?       @unique
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  failureReason       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([razorpayPaymentId])
  @@index([createdAt(sort: Desc)])
}

model SavedSearch {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @db.Uuid
  name      String
  filters   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId      String      @db.Uuid
  reportedUserId  String      @db.Uuid
  reportType      String
  description     String?     @db.Text
  status          String      @default("open") // open | reviewing | resolved | dismissed | escalated
  severity        String      @default("normal") // normal | high | critical
  adminNotes      String?     @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reporter        User        @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User        @relation("reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedUserId])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
}

model UserBlock {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId     String   @db.Uuid
  blockedUserId String   @db.Uuid
  reason        String?
  createdAt     DateTime @default(now())

  blocker       User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

model ProfileExposure {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerId         String   @db.Uuid
  candidateId      String   @db.Uuid
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  impressionCount  Int      @default(1)
  interactionState String   @default("seen") // seen | skipped | hidden | shortlisted | interest_sent | connected
  cooldownUntil    DateTime?

  viewer           User     @relation("exposureViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  candidate        User     @relation("exposureCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([viewerId, candidateId])
  @@index([viewerId, interactionState])
  @@index([viewerId, cooldownUntil])
}

model ContactRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String   @db.Uuid
  targetId    String   @db.Uuid
  status      String   @default("pending") // pending | approved | declined | withdrawn
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("contactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("contactTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model PhotoAccessRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String   @db.Uuid
  targetId    String   @db.Uuid
  status      String   @default("pending") // pending | approved | declined | withdrawn
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("photoAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User     @relation("photoAccessTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model SupportTicket {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  category     String
  subject      String
  description  String   @db.Text
  priority     String   @default("normal") // low | normal | high | critical
  status       String   @default("open") // open | assigned | in_progress | waiting_user | resolved | closed | escalated
  assignedTeam String?
  resolution   String?  @db.Text
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       SupportEvent[]

  @@index([userId, status])
  @@index([priority, status])
  @@index([createdAt(sort: Desc)])
}

model SupportEvent {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String        @db.Uuid
  actorType  String        // user | support | system
  actorId    String?
  eventType  String        // created | assigned | comment | status_changed | resolved | closed | reopened
  message    String?       @db.Text
  metadata   Json?
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model RiskSignal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  signalType  String
  severity    String   @default("low")
  source      String
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([signalType])
  @@index([severity])
}

model Review {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewerId      String      @db.Uuid
  reviewedUserId  String      @db.Uuid
  rating          Int
  comment         String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reviewer        User        @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser    User        @relation("reviewedUser", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, reviewedUserId])
  @@index([reviewedUserId])
  @@index([rating])
}

model AdminUser {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @unique @db.Uuid
  email         String      @unique
  passwordHash  String
  role          String      @default("admin")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([role])
}

model AuditLog {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?     @db.Uuid
  action        String
  resourceType  String?
  resourceId    String?
  changes       Json?
  ipAddress     String?     @db.VarChar(45)
  userAgent     String?     @db.VarChar(500)
  createdAt     DateTime    @default(now())

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}
