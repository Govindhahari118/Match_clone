DATABASE_URL=postgresql://matrimony_user:matrimony_dev_pass@localhost:5432/matrimony_db
PORT=4000
NODE_ENV=development
JWT_SECRET=dev_secret_key_change_me

# Optional Cloudinary settings for photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3 settings for media uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=


# OTP security + delivery. Production must configure a real provider.
OTP_HASH_SECRET=
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=

# Razorpay server-side verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
