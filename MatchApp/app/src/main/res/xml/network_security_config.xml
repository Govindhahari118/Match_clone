<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production trusts the Android system CA store and forbids cleartext traffic.
         Do not pin Google/Firebase managed endpoints: their certificate chains rotate. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
