rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profileHiddenFrom(ownerUid, viewerUid) {
      return firestore.exists(/databases/(default)/documents/privacyRelations/$(ownerUid)/members/$(viewerUid)) &&
        firestore.get(/databases/(default)/documents/privacyRelations/$(ownerUid)/members/$(viewerUid)).data.get('profileHidden', false) == true;
    }
    function blockedEitherWay(uidA, uidB) {
      return firestore.exists(/databases/(default)/documents/blocks/$(uidA)/blocked/$(uidB)) ||
        firestore.exists(/databases/(default)/documents/blocks/$(uidB)/blocked/$(uidA));
    }
    function explicitInterestFrom(ownerUid, viewerUid) {
      return firestore.exists(/databases/(default)/documents/interests/$(ownerUid + '_' + viewerUid));
    }
    function activeAccount(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid)) &&
        firestore.get(/databases/(default)/documents/users/$(uid)).data.get('accountStatus', 'ACTIVE') == 'ACTIVE';
    }
    function ownerCanReadOwnMedia(uid) {
      return signedIn() && request.auth.uid == uid && activeAccount(uid);
    }
    function peerCanReadProfileMedia(uid) {
      return signedIn() &&
        request.auth.uid != uid &&
        activeAccount(request.auth.uid) &&
        activeAccount(uid) &&
        !blockedEitherWay(request.auth.uid, uid) &&
        !profileHiddenFrom(uid, request.auth.uid) &&
        (firestore.get(/databases/(default)/documents/users/$(uid)).data.get('stealthMode', false) != true ||
          explicitInterestFrom(uid, request.auth.uid));
    }
    function publishedPhotoReadable(uid, fileName) {
      return ownerCanReadOwnMedia(uid) ||
        (peerCanReadProfileMedia(uid) &&
          firestore.get(/databases/(default)/documents/users/$(uid)).data.get('photoUrl', '') ==
            'photos/' + uid + '/' + fileName);
    }
    function publishedVideoReadable(uid, fileName) {
      return ownerCanReadOwnMedia(uid) ||
        (peerCanReadProfileMedia(uid) &&
          firestore.get(/databases/(default)/documents/users/$(uid)).data.get('videoUrl', '') ==
            'videos/' + uid + '/' + fileName);
    }
    function publishedVoiceBioReadable(uid, fileName) {
      return ownerCanReadOwnMedia(uid) ||
        (peerCanReadProfileMedia(uid) &&
          firestore.get(/databases/(default)/documents/users/$(uid)).data.get('voiceBioUrl', '') ==
            'voicebios/' + uid + '/' + fileName);
    }
    function chatExists(threadId) {
      return firestore.exists(/databases/(default)/documents/chats/$(threadId));
    }
    function chatParticipants(threadId) {
      return firestore.get(/databases/(default)/documents/chats/$(threadId)).data.participantUids;
    }
    function chatMember(threadId, uid) {
      return chatExists(threadId) &&
        chatParticipants(threadId).size() == 2 &&
        uid in chatParticipants(threadId);
    }
    function chatUsable(threadId) {
      return chatMember(threadId, request.auth.uid) &&
        activeAccount(chatParticipants(threadId)[0]) &&
        activeAccount(chatParticipants(threadId)[1]) &&
        !blockedEitherWay(chatParticipants(threadId)[0], chatParticipants(threadId)[1]);
    }
    function validChatMedia(threadId) {
      return request.resource.size > 0 && request.resource.size < 12 * 1024 * 1024 &&
        request.resource.metadata.keys().hasOnly(['senderUid','recipientUid','threadId','kind']) &&
        request.resource.metadata.senderUid == request.auth.uid &&
        request.resource.metadata.threadId == threadId &&
        request.resource.metadata.recipientUid in chatParticipants(threadId) &&
        request.resource.metadata.recipientUid != request.auth.uid &&
        (
          (request.resource.metadata.kind == 'image' &&
            request.resource.contentType.matches('image/.*')) ||
          (request.resource.metadata.kind == 'voice' &&
            request.resource.contentType.matches('audio/.*'))
        );
    }

    match /photos/{uid}/{fileName} {
      allow read: if publishedPhotoReadable(uid, fileName);
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /videos/{uid}/{fileName} {
      allow read: if publishedVideoReadable(uid, fileName);
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /voicebios/{uid}/{fileName} {
      allow read: if publishedVoiceBioReadable(uid, fileName);
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /verifications/{uid}/{allPaths=**} {
      // Raw KYC material is never client-readable. Existing clients may still upload their own
      // protected object; only the new backend callable can convert a metadata-bound object into a
      // PENDING verification state.
      allow read: if false;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if false;
    }
    match /chat-media/{threadId}/{fileName} {
      allow read: if signedIn() && chatUsable(threadId);
      allow create: if signedIn() && chatUsable(threadId) && validChatMedia(threadId);
      allow update: if signedIn() && chatUsable(threadId) &&
        resource.metadata.senderUid == request.auth.uid &&
        request.resource.metadata.senderUid == request.auth.uid &&
        validChatMedia(threadId);
      allow delete: if signedIn() && chatUsable(threadId) &&
        resource.metadata.senderUid == request.auth.uid;
    }
  }
}
