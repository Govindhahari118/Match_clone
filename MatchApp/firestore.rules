rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function hasNoPrivateProfileFields() { return !('email' in request.resource.data) && !('phoneNumber' in request.resource.data) && !('fcmToken' in request.resource.data) && !('dateOfBirth' in request.resource.data); }
    function safeUserCreate() { return hasNoPrivateProfileFields() && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) && (!('matrimonyId' in request.resource.data) || request.resource.data.matrimonyId == '') && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0) && (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan == 'FREE') && (!('subscriptionExpiry' in request.resource.data) || request.resource.data.subscriptionExpiry == 0) && !('premiumPlan' in request.resource.data) && !('premiumUntil' in request.resource.data) && !('paymentId' in request.resource.data); }
    function userServerFieldsUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium','isVerified','matrimonyId','verificationLevel','subscriptionPlan','subscriptionExpiry','premiumPlan','premiumUntil','paymentId','contactsRevealedThisMonth','contactsResetAt']); }
    function blockedEitherWay(viewerUid, targetUid) {
      return exists(/databases/$(database)/documents/blocks/$(viewerUid)/blocked/$(targetUid)) ||
             exists(/databases/$(database)/documents/blocks/$(targetUid)/blocked/$(viewerUid));
    }
    function mutualInterest(uidA, uidB) {
      return exists(/databases/$(database)/documents/interests/$(uidA + '_' + uidB)) &&
             exists(/databases/$(database)/documents/interests/$(uidB + '_' + uidA));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || !blockedEitherWay(request.auth.uid, userId));
      allow create: if isOwner(userId) && safeUserCreate();
      allow update: if isOwner(userId) && hasNoPrivateProfileFields() && userServerFieldsUnchanged();
      allow delete: if isOwner(userId);
    }
    match /userPrivate/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['email','phoneNumber','fcmToken','dateOfBirth','rasi','nakshatra','manglik','birthTime','birthPlace','incomeBand','lastActiveAt','updatedAt']);
      allow delete: if isOwner(userId);
    }
    match /interests/{interestId} {
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid && !blockedEitherWay(request.auth.uid, request.resource.data.toUid) && interestId == request.auth.uid + '_' + request.resource.data.toUid;
      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }
    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.resource.data.users is list && request.resource.data.users.size() == 2 && request.auth.uid in request.resource.data.users && request.resource.data.users[0] != request.resource.data.users[1] && mutualInterest(request.resource.data.users[0], request.resource.data.users[1]) && !blockedEitherWay(request.resource.data.users[0], request.resource.data.users[1]);
      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
      allow update: if false;
    }
    match /shortlists/{ownerUid}/saved/{targetUid} { allow read, write: if isOwner(ownerUid) && !blockedEitherWay(ownerUid, targetUid); }
    match /shortlists/{ownerUid} { allow read: if isOwner(ownerUid); }
    match /blocks/{blockerUid}/blocked/{blockedUid} { allow read, write: if isOwner(blockerUid); }
    match /blocks/{blockerUid} { allow read: if isOwner(blockerUid); }

    match /chats/{threadId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() && request.resource.data.participantUids is list && request.resource.data.participantUids.size() == 2 && request.resource.data.participantUids[0] != request.resource.data.participantUids[1] && request.auth.uid in request.resource.data.participantUids && mutualInterest(request.resource.data.participantUids[0], request.resource.data.participantUids[1]) && !blockedEitherWay(request.resource.data.participantUids[0], request.resource.data.participantUids[1]) && request.resource.data.keys().hasOnly(['participantUids','lastMessage','lastSentAt']);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids && request.resource.data.participantUids == resource.data.participantUids && mutualInterest(resource.data.participantUids[0], resource.data.participantUids[1]) && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSentAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids && mutualInterest(get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[0], get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[1]) && !blockedEitherWay(get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[0], get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[1]) && request.resource.data.fromFirebaseUid == request.auth.uid && request.resource.data.toFirebaseUid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids && request.resource.data.toFirebaseUid != request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() <= 3000 && request.resource.data.sentAt is int && request.resource.data.isRead == false && request.resource.data.keys().hasOnly(['body','sentAt','isRead','fromFirebaseUid','toFirebaseUid','voiceUri','imageUri','voiceDurationMs']);
        allow update: if isSignedIn() && resource.data.toFirebaseUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }

    match /events/{eventId} { allow read: if isSignedIn(); allow write: if false; }
    match /eventRegistrations/{regId} { allow read: if isSignedIn() && resource.data.uid == request.auth.uid; allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if false; }
    match /counsellingBookings/{bookingId} { allow read: if isSignedIn() && resource.data.uid == request.auth.uid; allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if false; }
    match /referrals/{refId} { allow read: if isSignedIn() && resource.data.referrerUid == request.auth.uid; allow create: if isSignedIn() && request.resource.data.referrerUid == request.auth.uid; allow update, delete: if false; }
    match /rmRequests/{reqId} { allow read: if isSignedIn() && resource.data.uid == request.auth.uid; allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if false; }
    match /backgroundChecks/{checkId} { allow read: if isSignedIn() && resource.data.requestedBy == request.auth.uid; allow create: if isSignedIn() && request.resource.data.requestedBy == request.auth.uid; allow update, delete: if false; }
    match /callRequests/{callId} { allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid && !blockedEitherWay(request.auth.uid, request.resource.data.toUid) && request.resource.data.status == 'requested'; allow update: if isSignedIn() && resource.data.toUid == request.auth.uid && request.resource.data.fromUid == resource.data.fromUid && request.resource.data.toUid == resource.data.toUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['accepted','declined']; allow delete: if false; }
    match /profileAnalytics/{uid} { allow read: if isOwner(uid); allow write: if false; match /weekly/{weekId} { allow read: if isOwner(uid); allow write: if false; } }
    match /communities/{communityId} { allow read: if isSignedIn(); allow write: if false; match /members/{memberId} { allow read: if isSignedIn(); allow create, delete: if isOwner(memberId); } }
    match /verifications/{uid} { allow read: if isOwner(uid); allow create: if isOwner(uid); allow update, delete: if false; }
    match /verificationRequests/{uid} { allow read: if isOwner(uid); allow create: if isOwner(uid) && request.resource.data.status == 'pending'; allow update: if isOwner(uid) && resource.data.status == 'pending' && request.resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['docType','documentPath','selfiePath','employmentPath','submittedAt']); allow delete: if false; }
    match /notifications/{notifId} { allow read: if isSignedIn() && resource.data.userId == request.auth.uid; allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']); allow create, delete: if false; }
    match /notificationPrefs/{uid} { allow read, write: if isOwner(uid); }
    match /profileViews/{viewId} { allow read: if isSignedIn() && (resource.data.viewerUid == request.auth.uid || resource.data.viewedUid == request.auth.uid); allow create: if isSignedIn() && request.resource.data.viewerUid == request.auth.uid && request.resource.data.viewedUid is string && request.resource.data.viewedUid != request.auth.uid && !blockedEitherWay(request.auth.uid, request.resource.data.viewedUid); allow update, delete: if false; }
    match /sessions/{uid}/devices/{deviceId} { allow read: if isOwner(uid); allow write: if false; }
    match /sessions/{uid} { allow read: if isOwner(uid); }
    match /otpLog/{hash} { allow read, write: if false; }
    match /paymentOrders/{orderId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /webhookEvents/{eventId} { allow read, write: if false; }
    match /deletionRequests/{uid} { allow read, write: if false; }
    match /subscriptions/{uid}/{allPaths=**} { allow read, write: if false; }
  }
}
