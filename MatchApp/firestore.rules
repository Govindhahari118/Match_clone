rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function hasNoPrivateProfileFields() {
      return !('email' in request.resource.data) &&
             !('phoneNumber' in request.resource.data) &&
             !('fcmToken' in request.resource.data) &&
             !('dateOfBirth' in request.resource.data) &&
             !('rasi' in request.resource.data) &&
             !('nakshatra' in request.resource.data) &&
             !('manglik' in request.resource.data) &&
             !('birthTime' in request.resource.data) &&
             !('birthPlace' in request.resource.data) &&
             !('incomeBand' in request.resource.data);
    }
    function validReligionValue(data) {
      return !('religion' in data) || data.religion == '' ||
        (data.religion is string && data.religion in [
          'Hindu', 'Muslim', 'Christian', 'Sikh', 'Buddhist', 'Jain',
          'Parsi / Zoroastrian', 'Other', 'Prefer not to say'
        ]);
    }
    function unconfirmedReligionOnCreate() {
      return !('religion' in request.resource.data) || request.resource.data.religion == '';
    }
    function noClientReligionAuthorityOnCreate() {
      return !('religionId' in request.resource.data) &&
             !('religionLocked' in request.resource.data) &&
             !('religionConfirmedAt' in request.resource.data);
    }
    function validProfileRevisionOnCreate() {
      return !('profileRevision' in request.resource.data) ||
             (request.resource.data.profileRevision is int &&
              request.resource.data.profileRevision == 0);
    }
    function validProfileRevisionUpdate() {
      return request.resource.data.profileRevision is int &&
             request.resource.data.profileRevision ==
               resource.data.get('profileRevision', 0) + 1;
    }
    function safeUserCreate() {
      return hasNoPrivateProfileFields() &&
             validReligionValue(request.resource.data) &&
             unconfirmedReligionOnCreate() &&
             noClientReligionAuthorityOnCreate() &&
             validProfileRevisionOnCreate() &&
             (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
             (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
             (!('matrimonyId' in request.resource.data) || request.resource.data.matrimonyId == '') &&
             (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0) &&
             !('subscriptionPlan' in request.resource.data) &&
             !('subscriptionExpiry' in request.resource.data) &&
             !('premiumPlan' in request.resource.data) &&
             !('premiumUntil' in request.resource.data) &&
             !('paymentId' in request.resource.data) &&
             !('username' in request.resource.data) &&
             !('usernameNormalized' in request.resource.data) &&
             !('lastActiveAt' in request.resource.data) &&
             !('profileCompleteness' in request.resource.data) &&
             !('profileCompletenessUpdatedAt' in request.resource.data) &&
             !('matchScore' in request.resource.data) &&
             !('profileViewCount' in request.resource.data) &&
             !('createdAt' in request.resource.data) &&
             (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == '') &&
             (!('videoUrl' in request.resource.data) || request.resource.data.videoUrl == '') &&
             (!('voiceBioUrl' in request.resource.data) || request.resource.data.voiceBioUrl == '');
    }
    function userServerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPremium','isVerified','matrimonyId','verificationLevel','subscriptionPlan',
        'subscriptionExpiry','premiumPlan','premiumUntil','paymentId',
        'contactsRevealedThisMonth','contactsResetAt','username','usernameNormalized',
        'lastActiveAt','boostActiveUntil','accountStatus','userPaused','matrimonyPaused','searchStatus','pausedAt',
        'religion','religionId','religionLocked','religionConfirmedAt',
        'profileCompleteness','profileCompletenessUpdatedAt','matchScore','profileViewCount','createdAt',
        'photoUrl','videoUrl','voiceBioUrl'
      ]);
    }
    function peerReadableAccount(data) {
      return !('accountStatus' in data) || data.accountStatus == 'ACTIVE';
    }
    function activeAccount(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             peerReadableAccount(get(/databases/$(database)/documents/users/$(uid)).data);
    }
    function activePair(uidA, uidB) {
      return activeAccount(uidA) && activeAccount(uidB);
    }
    function blockedEitherWay(viewerUid, targetUid) {
      return exists(/databases/$(database)/documents/blocks/$(viewerUid)/blocked/$(targetUid)) ||
             exists(/databases/$(database)/documents/blocks/$(targetUid)/blocked/$(viewerUid));
    }
    function profileHiddenFrom(ownerUid, viewerUid) {
      return exists(/databases/$(database)/documents/privacyRelations/$(ownerUid)/members/$(viewerUid)) &&
             get(/databases/$(database)/documents/privacyRelations/$(ownerUid)/members/$(viewerUid)).data.get('profileHidden', false) == true;
    }
    function mutualInterest(uidA, uidB) {
      return exists(/databases/$(database)/documents/interests/$(uidA + '_' + uidB)) &&
             exists(/databases/$(database)/documents/interests/$(uidB + '_' + uidA));
    }
    function explicitInterestFrom(profileOwnerUid, viewerUid) {
      return exists(/databases/$(database)/documents/interests/$(profileOwnerUid + '_' + viewerUid));
    }
    function chatAfterParticipants(threadId) {
      return getAfter(/databases/$(database)/documents/chats/$(threadId)).data.participantUids;
    }
    function validMessagePayload(threadId, messageId, data) {
      return messageId.matches('^[A-Za-z0-9_-]{16,128}$') &&
        data.body is string &&
        data.body.size() > 0 &&
        data.body.size() <= 3000 &&
        data.sentAt is int &&
        data.sentAt > 0 &&
        data.isRead == false &&
        !(
          ('voiceUri' in data) && data.voiceUri != null &&
          ('imageUri' in data) && data.imageUri != null
        ) &&
        (
          !('imageUri' in data) || data.imageUri == null ||
          (
            data.imageUri is string &&
            data.imageUri.matches(
              '^chat-media/' + threadId + '/' + messageId + '\\.jpg$'
            )
          )
        ) &&
        (
          !('voiceUri' in data) || data.voiceUri == null ||
          (
            data.voiceUri is string &&
            data.voiceUri.matches(
              '^chat-media/' + threadId + '/' + messageId + '\\.m4a$'
            )
          )
        ) &&
        (
          (
            ('voiceUri' in data) && data.voiceUri != null &&
            data.voiceDurationMs is int &&
            data.voiceDurationMs >= 500 &&
            data.voiceDurationMs <= 300000
          ) ||
          (
            (!('voiceUri' in data) || data.voiceUri == null) &&
            (!('voiceDurationMs' in data) || data.voiceDurationMs == null)
          )
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) ||
        (peerReadableAccount(resource.data) &&
         !blockedEitherWay(request.auth.uid, userId) &&
         !profileHiddenFrom(userId, request.auth.uid) &&
         (resource.data.stealthMode != true || explicitInterestFrom(userId, request.auth.uid))));
      allow create: if isOwner(userId) && safeUserCreate();
      allow update: if isOwner(userId) &&
        hasNoPrivateProfileFields() &&
        userServerFieldsUnchanged() &&
        validReligionValue(request.resource.data) &&
        validProfileRevisionUpdate();
      allow delete: if false;
    }
    match /userPrivate/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.keys().hasOnly(['email','phoneNumber','dateOfBirth','rasi','nakshatra','manglik','birthTime','birthPlace','incomeBand','lastActiveAt','updatedAt']);
      allow delete: if isOwner(userId);
    }
    match /usernames/{username} { allow read, write: if false; }

    match /privacyRelations/{ownerUid}/members/{memberUid} {
      allow read: if isOwner(ownerUid);
      allow create, update: if isOwner(ownerUid) && ownerUid != memberUid &&
        request.resource.data.memberUid == memberUid &&
        request.resource.data.keys().hasOnly(['memberUid','profileHidden','contactHidden','updatedAt']) &&
        (!('profileHidden' in request.resource.data) || request.resource.data.profileHidden is bool) &&
        (!('contactHidden' in request.resource.data) || request.resource.data.contactHidden is bool);
      allow delete: if isOwner(ownerUid);
    }
    match /privacyRelations/{ownerUid} { allow read: if isOwner(ownerUid); allow write: if false; }
    match /privacySettings/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow create, update: if isOwner(ownerUid) &&
        request.resource.data.keys().hasOnly(['contactVisibility','onlineVisibility','lastActiveVisibility','updatedAt']) &&
        (!('contactVisibility' in request.resource.data) || request.resource.data.contactVisibility in ['mutual_matches','selected_people','nobody']) &&
        (!('onlineVisibility' in request.resource.data) || request.resource.data.onlineVisibility in ['everyone','interests','mutual','nobody']) &&
        (!('lastActiveVisibility' in request.resource.data) || request.resource.data.lastActiveVisibility in ['everyone','interests','mutual','nobody']);
      allow delete: if isOwner(ownerUid);
    }
    match /contactGrants/{ownerUid}/viewers/{viewerUid} {
      allow read: if isOwner(ownerUid);
      allow create, update: if isOwner(ownerUid) && ownerUid != viewerUid &&
        request.resource.data.viewerUid == viewerUid &&
        request.resource.data.keys().hasOnly(['viewerUid','phoneAllowed','whatsappAllowed','grantedAt','updatedAt']) &&
        request.resource.data.phoneAllowed is bool &&
        request.resource.data.whatsappAllowed is bool &&
        (request.resource.data.phoneAllowed == true || request.resource.data.whatsappAllowed == true);
      allow delete: if isOwner(ownerUid);
    }
    match /contactGrants/{ownerUid} { allow read: if isOwner(ownerUid); allow write: if false; }
    match /contactRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.requesterUid == request.auth.uid || resource.data.targetUid == request.auth.uid) &&
        !blockedEitherWay(resource.data.requesterUid, resource.data.targetUid);
      allow write: if false;
    }
    match /presencePrivate/{uid} { allow read, write: if false; }

    match /interests/{interestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) &&
        activePair(resource.data.fromUid, resource.data.toUid) &&
        !blockedEitherWay(resource.data.fromUid, resource.data.toUid);
      allow create, update, delete: if false;
    }
    match /matches/{matchId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.users &&
        resource.data.users.size() == 2 &&
        activePair(resource.data.users[0], resource.data.users[1]) &&
        !blockedEitherWay(resource.data.users[0], resource.data.users[1]);
      allow create, update, delete: if false;
    }
    match /interestResponses/{responseId} { allow read, write: if false; }

    match /savedSearches/{ownerUid}/items/{searchId} {
      allow read: if isOwner(ownerUid);
      allow create, update, delete: if false;
    }
    match /savedSearches/{ownerUid} { allow read: if isOwner(ownerUid); allow write: if false; }
    match /partnerPreferences/{ownerUid} { allow read, write: if false; }
    match /recommendationFeedback/{viewerUid}/targets/{targetUid} { allow read, write: if false; }
    match /recommendationFeedback/{viewerUid} { allow read, write: if false; }
    match /recommendationImpressionBatches/{batchId} { allow read, write: if false; }

    match /shortlists/{ownerUid}/saved/{targetUid} { allow read, write: if isOwner(ownerUid) && !blockedEitherWay(ownerUid, targetUid) && !profileHiddenFrom(targetUid, ownerUid); }
    match /shortlists/{ownerUid} { allow read: if isOwner(ownerUid); }
    match /blocks/{blockerUid}/blocked/{blockedUid} {
      allow read: if isOwner(blockerUid);
      // Block/unblock also revokes trusted relationship state, so mutations are callable-only.
      allow write: if false;
    }
    match /blocks/{blockerUid} { allow read: if isOwner(blockerUid); allow write: if false; }

    match /chats/{threadId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids &&
        resource.data.participantUids.size() == 2 &&
        activePair(resource.data.participantUids[0], resource.data.participantUids[1]) &&
        !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]);
      allow create: if isSignedIn() && request.resource.data.participantUids is list && request.resource.data.participantUids.size() == 2 && request.resource.data.participantUids[0] != request.resource.data.participantUids[1] && request.auth.uid in request.resource.data.participantUids && activePair(request.resource.data.participantUids[0], request.resource.data.participantUids[1]) && mutualInterest(request.resource.data.participantUids[0], request.resource.data.participantUids[1]) && !blockedEitherWay(request.resource.data.participantUids[0], request.resource.data.participantUids[1]) && request.resource.data.keys().hasOnly(['participantUids','lastMessage','lastSentAt']);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids && request.resource.data.participantUids == resource.data.participantUids && activePair(resource.data.participantUids[0], resource.data.participantUids[1]) && mutualInterest(resource.data.participantUids[0], resource.data.participantUids[1]) && !blockedEitherWay(resource.data.participantUids[0], resource.data.participantUids[1]) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSentAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids &&
          get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids.size() == 2 &&
          activePair(
            get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[0],
            get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[1]
          ) &&
          !blockedEitherWay(
            get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[0],
            get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids[1]
          );
        allow create: if isSignedIn() &&
          chatAfterParticipants(threadId) is list &&
          chatAfterParticipants(threadId).size() == 2 &&
          request.auth.uid in chatAfterParticipants(threadId) &&
          activePair(chatAfterParticipants(threadId)[0], chatAfterParticipants(threadId)[1]) &&
          mutualInterest(chatAfterParticipants(threadId)[0], chatAfterParticipants(threadId)[1]) &&
          !blockedEitherWay(chatAfterParticipants(threadId)[0], chatAfterParticipants(threadId)[1]) &&
          request.resource.data.fromFirebaseUid == request.auth.uid &&
          request.resource.data.toFirebaseUid in chatAfterParticipants(threadId) &&
          request.resource.data.toFirebaseUid != request.auth.uid &&
          validMessagePayload(threadId, messageId, request.resource.data) &&
          request.resource.data.keys().hasOnly(['body','sentAt','isRead','fromFirebaseUid','toFirebaseUid','voiceUri','imageUri','voiceDurationMs']);
        allow update: if isSignedIn() && resource.data.toFirebaseUid == request.auth.uid &&
          activePair(resource.data.fromFirebaseUid, resource.data.toFirebaseUid) &&
          !blockedEitherWay(resource.data.fromFirebaseUid, resource.data.toFirebaseUid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','deliveredAt','readAt']) &&
          (request.resource.data.isRead == resource.data.isRead ||
            (resource.data.isRead == false && request.resource.data.isRead == true)) &&
          (!('deliveredAt' in request.resource.data) || request.resource.data.deliveredAt is timestamp) &&
          (!('readAt' in request.resource.data) || request.resource.data.readAt is timestamp) &&
          (!('readAt' in request.resource.data) || request.resource.data.isRead == true) &&
          (request.resource.data.isRead != true ||
            (
              request.resource.data.readAt is timestamp &&
              request.resource.data.deliveredAt is timestamp
            ));
        allow delete: if false;
      }
    }

    // Retired/hidden product surfaces remain server-only. Keeping Kotlin prototypes in source is not
    // authorization for a modified client to inspect legacy catalogue, service-request or analytics
    // documents. A future promotion must introduce an audited callable/rules contract deliberately.
    match /events/{eventId} { allow read, write: if false; }
    match /eventRegistrations/{regId} { allow read, write: if false; }
    match /counsellingBookings/{bookingId} { allow read, write: if false; }
    match /referrals/{refId} { allow read, write: if false; }
    match /rmRequests/{reqId} { allow read, write: if false; }
    match /backgroundChecks/{checkId} { allow read, write: if false; }
    match /callRequests/{callId} { allow read, write: if false; }
    match /profileAnalytics/{uid} {
      allow read, write: if false;
      match /weekly/{weekId} { allow read, write: if false; }
    }
    match /communities/{communityId} {
      allow read, write: if false;
      match /members/{memberId} { allow read, write: if false; }
    }
    match /verifications/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /verificationRequests/{uid} {
      allow read: if isOwner(uid);
      // Pending/verified/rejected state is written only by trusted Functions/admin review. Clients
      // first upload a protected Storage object and then call submitVerificationRequest.
      allow create, update, delete: if false;
    }

    // Consent state is server-written so clients cannot fabricate the version or timestamp that
    // authorized a sensitive operation. Members may read only their own current state/history.
    match /consents/{uid}/items/{purpose} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }
    match /consents/{uid} { allow read: if isOwner(uid); allow write: if false; }
    match /consentLedger/{uid}/events/{eventId} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }
    match /consentLedger/{uid} { allow read: if isOwner(uid); allow write: if false; }

    // Fraud/risk evidence and reviewed assessments are never directly readable or writable by
    // member clients. A privacy-safe Trust summary is returned through an authorized callable.
    match /riskSignals/{uid} { allow read, write: if false; }
    match /riskAssessments/{uid} { allow read, write: if false; }
    match /riskActivity/{uid}/days/{day} { allow read, write: if false; }
    match /photoFingerprints/{fingerprintId} { allow read, write: if false; }
    match /photoModeration/{caseId} { allow read, write: if false; }
    match /accountEnforcements/{uid} { allow read, write: if false; }
    match /securityEvents/{eventId} { allow read, write: if false; }
    match /notifications/{notifId} { allow read: if isSignedIn() && resource.data.userId == request.auth.uid; allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']); allow create, delete: if false; }
    match /notificationPrefs/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['interests','matches','messages','system']) &&
        (!('interests' in request.resource.data) || request.resource.data.interests is bool) &&
        (!('matches' in request.resource.data) || request.resource.data.matches is bool) &&
        (!('messages' in request.resource.data) || request.resource.data.messages is bool) &&
        (!('system' in request.resource.data) || request.resource.data.system is bool);
      allow delete: if isOwner(uid);
    }
    match /appearancePrefs/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['themePreference','manualThemeKey','updatedAt']) &&
        request.resource.data.themePreference is string &&
        request.resource.data.themePreference in ['PROFILE_RELIGION','AUTOMATIC','NEUTRAL','MANUAL'] &&
        request.resource.data.manualThemeKey is string &&
        request.resource.data.manualThemeKey in [
          'VIVAH','HINDU','MUSLIM','CHRISTIAN','SIKH','BUDDHIST','JAIN','PARSI'
        ] &&
        request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(uid);
    }
    match /profileViews/{viewId} { allow read: if isSignedIn() && (resource.data.viewerUid == request.auth.uid || resource.data.viewedUid == request.auth.uid); allow create, update, delete: if false; }
    match /fcmTokens/{uid}/devices/{deviceId} { allow read, write: if false; }
    match /fcmTokens/{uid} { allow read, write: if false; }
    match /fcmDeviceOwners/{deviceId} { allow read, write: if false; }
    match /sessions/{uid}/devices/{deviceId} { allow read: if isOwner(uid); allow write: if false; }
    match /sessions/{uid} { allow read: if isOwner(uid); }
    match /otpLog/{hash} { allow read, write: if false; }
    match /supportTickets/{ticketId} { allow read, write: if false; }
    match /profileReports/{reportId} { allow read, write: if false; }
    match /opsAuditLog/{auditId} { allow read, write: if false; }
    match /adminAudit/{auditId} { allow read, write: if false; }
    match /paymentOrders/{orderId} { allow read, write: if false; }
    match /payments/{paymentId} { allow read, write: if false; }
    match /webhookEvents/{eventId} { allow read, write: if false; }
    match /deletionRequests/{uid} { allow read, write: if false; }
    match /subscriptions/{uid}/{allPaths=**} { allow read, write: if false; }
    match /userLocations/{uid} { allow read, write: if false; }
    match /videoModeration/{docId} { allow read, write: if false; }
  }
}
