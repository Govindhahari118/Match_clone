rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function safeUserCreate() {
      return (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false)
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false)
        && (!('matrimonyId' in request.resource.data) || request.resource.data.matrimonyId == '')
        && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0)
        && (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan == 'FREE')
        && (!('subscriptionExpiry' in request.resource.data) || request.resource.data.subscriptionExpiry == 0)
        && !('premiumPlan' in request.resource.data)
        && !('premiumUntil' in request.resource.data)
        && !('paymentId' in request.resource.data);
    }

    function userServerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPremium',
        'isVerified',
        'matrimonyId',
        'verificationLevel',
        'subscriptionPlan',
        'subscriptionExpiry',
        'premiumPlan',
        'premiumUntil',
        'paymentId'
      ]);
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Signed-in users may discover profiles. Owners may edit normal profile fields,
    // but billing/verification/system identity fields are server-owned.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && safeUserCreate();
      allow update: if isOwner(userId) && userServerFieldsUnchanged();
      allow delete: if isOwner(userId);
    }

    // ── Interests (likes) ─────────────────────────────────────────────────
    // Document ID: {fromUid}_{toUid}. Only participants can read an interest.
    match /interests/{interestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && interestId == request.auth.uid + '_' + request.resource.data.toUid;
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    // ── Matches ───────────────────────────────────────────────────────────
    // A client may materialize a match only when BOTH directed interests already exist.
    // This preserves the current client flow while preventing fabricated matches.
    match /matches/{matchId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.users;
      allow create: if isSignedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] != request.resource.data.users[1]
        && exists(/databases/$(database)/documents/interests/$(request.resource.data.users[0] + '_' + request.resource.data.users[1]))
        && exists(/databases/$(database)/documents/interests/$(request.resource.data.users[1] + '_' + request.resource.data.users[0]));
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.users;
      allow update: if false;
    }

    // ── Shortlists ────────────────────────────────────────────────────────
    match /shortlists/{ownerUid}/saved/{targetUid} {
      allow read, write: if isOwner(ownerUid);
    }
    match /shortlists/{ownerUid} {
      allow read: if isOwner(ownerUid);
    }

    // ── Blocks ────────────────────────────────────────────────────────────
    match /blocks/{blockerUid}/blocked/{blockedUid} {
      allow read, write: if isOwner(blockerUid);
    }
    match /blocks/{blockerUid} {
      allow read: if isOwner(blockerUid);
    }

    // ── Chats ─────────────────────────────────────────────────────────────
    // Authorization uses Firebase Auth UIDs. Numeric IDs are app-domain metadata only.
    match /chats/{threadId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSentAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids
          && request.resource.data.fromFirebaseUid == request.auth.uid
          && request.resource.data.toFirebaseUid in get(/databases/$(database)/documents/chats/$(threadId)).data.participantUids
          && request.resource.data.toFirebaseUid != request.auth.uid
          && request.resource.data.isRead == false;
        allow update: if isSignedIn()
          && resource.data.toFirebaseUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }

    // ── Events ────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Event Registrations ───────────────────────────────────────────────
    match /eventRegistrations/{regId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Counselling Bookings ──────────────────────────────────────────────
    match /counsellingBookings/{bookingId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Referrals ─────────────────────────────────────────────────────────
    match /referrals/{refId} {
      allow read: if isSignedIn()
        && resource.data.referrerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.referrerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── RM Requests (Assisted Matchmaking) ────────────────────────────────
    match /rmRequests/{reqId} {
      allow read: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Background Checks ─────────────────────────────────────────────────
    match /backgroundChecks/{checkId} {
      allow read: if isSignedIn()
        && resource.data.requestedBy == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Call Requests (Secure Call / Virtual Meet) ─────────────────────────
    match /callRequests/{callId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // ── Profile Analytics ─────────────────────────────────────────────────
    match /profileAnalytics/{uid} {
      allow read, write: if isOwner(uid);

      match /weekly/{weekId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Communities ───────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isOwner(memberId);
        allow delete: if isOwner(memberId);
      }
    }

    // ── Verifications ─────────────────────────────────────────────────────
    match /verifications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if false;
      allow delete: if false;
    }

    // ── Verification Requests ─────────────────────────────────────────────
    match /verificationRequests/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.status == 'pending';
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create: if false;
      allow delete: if false;
    }

    // ── Notification Preferences ──────────────────────────────────────────
    match /notificationPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Sessions ──────────────────────────────────────────────────────────
    match /sessions/{uid}/devices/{deviceId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /sessions/{uid} {
      allow read: if isOwner(uid);
    }

    // ── OTP Log ───────────────────────────────────────────────────────────
    match /otpLog/{hash} {
      allow read, write: if false;
    }
  }
}
