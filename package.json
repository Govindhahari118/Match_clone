{
  "name": "matrimony-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Workspace utilities for running Matrimony App locally",
  "scripts": {
    "dev:up": "node ./scripts/dev-up.js",
    "dev:up:nodocker": "node ./scripts/dev-up.js --no-docker",
    "dev:down": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1",
    "dev:down:nodocker": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-down.ps1 -NoDocker",
    "dev:status": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-status.ps1",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose stop postgres redis"
  }
}
